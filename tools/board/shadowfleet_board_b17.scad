// =============================================================================
// SHADOW FLEET -- the 17-world board (layout B17, take 4, 2026-11-02):
// TWO HALVES of a 296 mm disc that snap together, and the 1.43" table console
// in a separate HUB piece that clips in from below.
// Layout + clearances: tools/board/mockups/sixteen_halves.py (true mm);
// decisions: the design notes "DECISIONS 2026-11-01".
//
// Parts: the two HALVES ("half_n", "half_s": every world, label, lane, hangar
// and nebula), the HUB and its back PLATE, and the center test print
// ("test_n", "test_s") that tuned the fits -- the user's test print fit as
// designed (2026-11-03), so the halves use the same numbers.
// The halves print UPSIDE DOWN (the pocket underneath would be an 88 mm bridge
// the other way up), so everything on top is engraved, nothing raised: the
// home worlds' rings, the nebula texture, the edge chamfer.
//
// How it holds together (user: "snap together and stay together", no welder,
// no staples, no tools):
//   - dovetails along the seam (y = 0), alternating which half they come from;
//     you press one half down onto the other; a small bump near the bottom of
//     each tab clicks into a dimple in its socket;
//   - the hub goes in from BELOW: its flange sits in a shallow pocket under
//     both halves, its column fills the hole, and 3 spring fingers hook over
//     the hole's top edge. While the hub is in, the halves can't part at the
//     center. Push the hub down hard to pop it out again.
//   - the hub's USB tongue keys into the south half, so it can't turn.
//
// Coordinates: mm, +x east, +y NORTH, z up from the underside. The board
// mockups measure angles from east with +90 = SOUTH, so a mockup angle a is
// -a here.
// =============================================================================

include <charm_data.scad>   // GENERATED by make_charm_data.py: curved names, stars, ticks, faction symbols, copper gaps, nebula orbits
PART = "assembly";  // "assembly" | "exploded" | "section" | "top" | "half_n" | "half_s" | "single" | "hub" | "plate" | "test_n" | "test_s" | "test_text"
                    // half_* / test_* come out upside down, ready to print

// ---- board -----------------------------------------------------------------
BASE_H     = 6;      // board thickness
BOARD_R    = 148;    // 296 mm across; one half fits a 256 mm bed turned 45 deg (tabs included, ~3 mm spare)
EDGE_CHAMFER = 1.0;  // the top edge
TEST_R     = 70;     // radius of the center test pieces (takes in the x = +-62 dovetails)
CORE_R     = 50;     // Core ring
CORE_ANGLES = [30, 150, 270];  // mockup angles: Kuat, Corellia, Coruscant
SLOT_D     = 17;     // token recess
SLOT_DEPTH = 1.6;
PEG_HOLE_D = 4.2;
PEG_HOLE_DEPTH = 2.6;
FLEET_HOLE_D = 3.2;
FLEET_HOLE_R = 12.5;
FLEET_HOLE_DEPTH = 2.4;
RING_W     = 1.4;
RING_DEPTH = 0.6;
LANE_W     = 2.2;
LANE_DEPTH = 0.8;

// ---- seam dovetails (mockup TABS; the test has the two nearest) --------------
NECK  = 7;           // tab width at the seam
HEAD  = 11;          // tab width at its end
DEPTH = 7;           // how far it reaches into the other half
JOINT_CLEAR = 0.15;  // gap all round the tab -- TUNE THIS on the test (0.1 tighter, 0.2 looser)
BUMP_R    = 1.0;     // click bump: a ball on each flank of the tab ...
BUMP_OUT  = 0.3;     // ... standing this proud of the flank
BUMP_Z    = 1.6;     // ... this high up the tab (the dimple in the socket is at the same height)
// x, which half the tab belongs to (+1 north: points south; -1 south: points north)
TABS = [[58, 1], [124, -1], [-58, -1], [-124, 1]];   // 2026-11-11: 58 (between the hub pocket and the station) + 124 (under the nebula's heart)
TEST_TABS = [[58, 1], [-58, -1]];

// ---- the layout (take 4; tools/board/mockups/sixteen_halves.py) -------------
// Mockup angles: from east, +90 = SOUTH.
MID_R = 90;
OUT_R = 124;
HANG_R = 137;
LABEL_SIZE = 3.6;
LABEL_DEPTH = 0.6;   // 2026-11-12: EVERY engraving is >= this deep -> a filament swap at BASE_H - LABEL_DEPTH (5.4 mm) colours them all (dark under a light top)
FOOT = FLEET_HOLE_R + 7.5 / 2;   // a slot's reach, fleet caps included
// name, ring radius, angle, home faction (-1 none; 0 R, 1 E, 2 P, 3 C), label radius
WORLDS = [
  ["YAVIN 4", 124, 36, 0, 124 - FOOT - 3], ["DAGOBAH", 124, 72, -1, 124 - FOOT - 3],
  ["TATOOINE", 124, 108, -1, 124 - FOOT - 3], ["OBA DIAH", 124, 144, 2, 124 - FOOT - 3],
  ["DATHOMIR", 124, 216, 3, 124 - FOOT - 3], ["KESSEL", 124, 252, -1, 124 - FOOT - 3],
  ["HOTH", 124, 288, -1, 124 - FOOT - 3], ["MUSTAFAR", 124, 324, 1, 124 - FOOT - 3],
  ["NABOO", 90, 45, -1, 90 + FOOT + 3], ["BESPIN", 90, 90, -1, 90 + FOOT + 3],   // 2026-11-11: Mid Rim at 45 deg steps + stations at 0 / 180   // 2026-11-11: Mid Rim labels OUTSIDE (the copper lines + the south junction box sit inside)
  ["NAL HUTTA", 90, 135, -1, 90 + FOOT + 3], ["CANTO BIGHT", 90, 225, -1, 90 + FOOT + 3],
  ["KIJIMI", 90, 270, -1, 90 + FOOT + 3],          // outside: inside is Coruscant's
  ["ENDOR", 90, 315, -1, 90 + FOOT + 3],
  ["KUAT", 50, 30, -1, 50 + FOOT + 2.5], ["CORELLIA", 50, 150, -1, 50 + FOOT + 2.5],
  ["CORUSCANT", 50, 270, -1, 50 + FOOT + 2.5, 19]];   // 6th: label shifted east (mm) -- off the Kijimi lane
LANES = [[1, 9], [2, 9], [5, 12], [6, 12], [0, 8], [3, 10], [4, 11], [7, 13], [12, 16], [9, 15], [9, 14]];
HANGARS = [[0, 12, 0], [2, 168, 3], [3, 192, 4], [1, 348, 7]];   // faction, angle, home world (index into WORLDS)
NUM_R = 5.0;      // fleet numbers: this far outside the hangar holes (their caps reach 3.75, the bracket 6.4)
NUM_SIZE = 2.2;
HANG_STEP = 4.6 * 116 / 137;                                      // deg between a hangar's 3 holes (~9.3 mm)
NEBULAE = [[0, 6], [180, -6]];
STATIONS = [0, 180];   // SPACE STATIONS (mockup angles) on the Mid Rim, straddling the seam; a fleet with no worlds launches here                                    // angle, fleet-hole row offset (mockup y, + = south)
HOME_LETTER = ["R", "E", "P", "C"];
HOME_LETTER_D = 14;      // the home world's letter: this far from its slot's center, in the gap
                         // between its fleet holes (30 / 150 / 270 deg) nearest the board's edge
HOME_RING = [9.4, 10.4]; // engraved ring round a home world's slot (between the slot and its fleet holes)
NEBULA_RX = 19;
NEBULA_RY = 14;
NEBULA_DIMPLES = 90;

// ---- hub ---------------------------------------------------------------------
HOLE_R    = 33.5;    // the hole through both halves
FIT       = 0.3;     // radial gap between the hub and the halves
FLANGE_R  = 44;      // flange under both halves
FLANGE_T  = 2.5;     // flange thickness = pocket depth
BEZEL_D   = 62;      // raised ring around the glass (as layout A3)
BEZEL_H   = 10;      // above the board top
EDGE_R    = 1.0;     // rounded top edge of the bezel
TOP       = BASE_H + BEZEL_H;

// the 1.43" console (Waveshare drawing; as layout A3)
GLASS_D   = 46;
GLASS_CLEAR = 0.6;
BORE_D    = GLASS_D + GLASS_CLEAR;  // cavity the module goes up into (its PCB is about as wide as the glass)
LIP_W     = 1.5;     // lip over the glass border (the lit area, 36.75 mm, stays clear)
LIP_T     = 1.2;
STACK_H   = 6.2;     // glass face to the back of the PCB
// 2026-11-15 (user: the pegs "don't actually land on the 4 screw holes"): checked against Waveshare's outline drawing
// (docs.waveshare.com/ESP32-S3-Touch-AMOLED-1.43, back view, USB-C at the bottom = -y): the four gold M2 holes are 31.50 apart at
// +11.60 (away from the USB) and 32.50 apart at -11.50. The old +15.25 was the height of the two SILVER points at the top edge
// (28.50 apart), not the screw holes -- the top pegs sat 3.65 mm too high.
SCREEN_HOLES = [[15.75, 11.60], [-15.75, 11.60], [16.25, -11.5], [-16.25, -11.5]];
PCB_BACK  = TOP - LIP_T - STACK_H;

// back plate (as A3): sits flush in a pocket in the hub's underside, its flat
// posts push the module up against the lip; 3 M2 self-tapping screws.
PLATE_D   = 56;
PLATE_T   = 3;
PLATE_SCREW_R = 26;
PLATE_SCREW_D = 1.8;   // pilot hole in the hub; the plate's hole is PLATE_PASS_D
PLATE_PASS_D = 2.8;    // 2026-11-11 test print: 2.4 printed ~2.1 and the M2 screws wouldn't pass
USB_NOTCH = [14, 9];
PLATE_POST_H = 3;      // 2026-11-14 user: the 4 pegs ~3 mm tall (were PCB_BACK - PLATE_T = 5.6 mm, reaching the PCB)

// USB: a straight USB-C plug points SOUTH (between Kuat and Corellia, the
// widest gap round the hub). The A3 tunnel + fairing ride on a TONGUE that
// fills a matching slot in the south half.
USB_DIR    = -90;
USB_TUNNEL = [16, TOP - LIP_T, 62];  // width, height from the underside (2026-11-07 user: up FLUSH with the lip -- was 12.4), reach from the center
                                 // (2026-11-03 print: the plug still kept the hub from seating flush -> +1.5 wide, +2 tall, +5 long)
FAIRING_W  = 21;
TONGUE_R   = 71;                 // the tongue (and its slot) reach this far out (2026-11-11: 66 -> 71, under the south junction box, same rounded outline as the box; Bespin's north fleet hole is at 77.5)
// Cable channel under the board, from inside the tunnel out to the edge,
// heading 45 deg off the plug so it misses Bespin's, Dagobah's and Naboo's
// peg holes on the full board (checked against the mockup positions).
CHANNEL_W  = 5.5;
CHANNEL_H  = 3.8;
CHANNEL_START = 50;
CHANNEL_DIR = -45;

// Spring fingers: a strip of the column wall, cut free on three sides,
// standing on a thin root at the bottom, with a hook at its top.
HOOK_ANGLES = [90, 210, 330];  // clear of the tongue (270); the plate screws are inboard of them
HOOK_W    = 9;       // finger width (mm of arc)
HOOK_T    = 1.2;     // finger thickness -- thinner = softer click (PLA: keep 1.0-1.4)
HOOK_ROOT = 1.0;     // the finger stands on this much of the hub's bottom
HOOK_OVER = 0.5;     // how far the hook reaches past the hole's edge
HOOK_CATCH = 35;     // underside angle (deg from flat): steeper holds harder, flatter pops out easier
HOOK_LEAD = 55;      // top (lead-in) angle
HOOK_GAP  = 0.8;     // the slits round the finger
HOOK_LIFT = 0.6;     // raises the hook so its catch clears the hole's edge (2026-11-03 print: "so close", didn't lock -> 0.3; 2026-11-08: "a little taller" -> 0.6)

// ---- THE REACTOR HUB (2026-11-11; mockups tools/board/mockups/hub_hybrid.html, user: "a big fan") ----
// The hub now goes in FROM ABOVE: its reactor collar is the top flange resting on the board, and the
// spring hooks (the same fingers, mirrored) catch the hole's UNDERSIDE (the pocket ceiling). Three
// identical arms sit exactly between the Core worlds; the south one is today's plug tunnel. Each ends
// in a junction box. A pair of engraved "copper" lines circles the Core with brackets across them.
REACTOR_R  = 40;     // the collar (the top flange) -- 44 covered Kuat / Corellia's slots (inner edge 41.5)
REACTOR_H  = USB_TUNNEL[1] + 1.2 - BASE_H;   // the ARMS' height above the board (= 10, flush with the rim): the plug tunnel needs a 1.2 mm roof
COLLAR_H   = 6;      // the collar steps lower than the arms (the reactor look: rim + arms +10, collar +6, boxes +4)
RIM_R      = 33;     // the raised ring round the glass (to TOP)
ARM_ANGLES = [USB_DIR, USB_DIR + 120, USB_DIR + 240];   // between Kuat / Corellia / Coruscant
ARM_W      = FAIRING_W;
ARM_R1     = USB_TUNNEL[2] + 1.2;   // the arms end just past the tunnel (a 1.2 mm end wall; the box joins it there)
RIB_R      = [40, 46, 52, 58];    // grooves across the arms' tops
RIB_W      = 1.2;
RIB_D      = 0.3;     // the south arm's roof over the tunnel is only 1.2 mm
BOX_R0     = ARM_R1 - 2.2;      // junction boxes
BOX_R1     = TONGUE_R;
BOX_W      = 15;
BOX_H      = 4;
BOX_RND    = 2;
FIN_STEP   = 12;              // cooling fins across the collar top, between the arms
FIN_W      = 1.6;
FIN_DEPTH  = 1.5;
FIN_R      = [RIM_R + 1.8, REACTOR_R - 1.4];
COPPER_R   = [66.5, 69.5];    // the two engraved lines (fill / paint them copper)
COPPER_W   = 1.2;
COPPER_D   = 0.8;
COPPER_GAPS = [[16, 44], [72, 108], [136, 164], [256, 300]];   // MOCKUP angles: Kuat, the south arm + Bespin's lanes, Corellia, Coruscant + its label
BRACKETS   = [0, 58, 122, 180, 232, 316];                       // MOCKUP angles; 0 / 180 sit on the seam
BRACKET_W  = 5;               // mm of arc
BRACKET_R  = [64.4, 71.6];

// ---------------------------------------------------------------------------
function pol(r, a) = [r * cos(a), r * sin(a)];
function core_spot(a) = pol(CORE_R, -a);
function mpol(r, a) = pol(r, -a);                 // a mockup position
function world_at(i) = mpol(WORLDS[i][1], WORLDS[i][2]);
COL_R = HOLE_R - FIT;   // the hub's column

// ---- hub --------------------------------------------------------------------
module along_usb() { rotate([0, 0, USB_DIR]) children(); }   // +x = along the plug

module box2d() { translate([BOX_R0, -BOX_W / 2]) translate([BOX_RND, BOX_RND]) offset(r = BOX_RND, $fn = 24) square([BOX_R1 - BOX_R0 - 2 * BOX_RND, BOX_W - 2 * BOX_RND]); }
module tongue2d(grow = 0) {
  along_usb() offset(delta = grow) union() {
    translate([0, -FAIRING_W / 2]) square([ARM_R1, FAIRING_W]);   // under the arm
    box2d();                                                      // under the junction box: same rounded outline
  }
}

module fairing() {
  roof = USB_TUNNEL[1] + 1.2;
  along_usb() {
    hull() {
      translate([BEZEL_D / 2 - 8, -FAIRING_W / 2, 0]) cube([8, FAIRING_W, TOP]);
      translate([USB_TUNNEL[2], -FAIRING_W / 2, 0]) cube([1, FAIRING_W, roof]);
    }
    hull() {  // full roof height over the whole tunnel, then down to the board at the tongue's end
      translate([USB_TUNNEL[2], -FAIRING_W / 2, 0]) cube([1, FAIRING_W, roof]);
      translate([TONGUE_R - 0.5, -FAIRING_W / 2, 0]) cube([0.5, FAIRING_W, BASE_H]);
    }
  }
}

module bezel() {
  rotate_extrude($fn = 120) difference() {
    square([BEZEL_D / 2, TOP]);
    translate([BEZEL_D / 2 - EDGE_R, TOP - EDGE_R]) difference() {
      square([EDGE_R + 0.01, EDGE_R + 0.01]);
      circle(r = EDGE_R, $fn = 24);
    }
  }
}

// 2026-11-11 (test print: the cable folded hard at the tunnel's end and tilted the screen; user: "if the cable just comes
// straight out, that's perfect"): the cable leaves the plug STRAIGHT, eases down an S-curve (CABLE_Z at the plug's
// boot -> the channel by CABLE_S1, ~25 mm bend), runs straight to CABLE_ARC0, sweeps CABLE_TURN deg on a CABLE_ARC_R arc,
// then straight to the edge. Route found by search: >= 1.6 mm clear of every peg / fleet hole (they reach below the
// channel's 3.8 mm). One groove, open underneath, round-topped; cut in the hub AND the halves.
CABLE_Z    = 7.0;    // the plug's centre above the underside
CABLE_S0   = 56;     // the boot ends here (plug + boot = 36 mm from the port)
CABLE_S1   = 76;     // ... and the cable is down in the channel here
CABLE_ARC0 = 68;     // the sweep starts
CABLE_ARC_R = 30;
CABLE_TURN = 25;     // deg, toward the east (+x)
function cable_z(s) = s <= CABLE_S0 ? CABLE_Z : s >= CABLE_S1 ? CHANNEL_H - CHANNEL_W / 2
  : let (u = (s - CABLE_S0) / (CABLE_S1 - CABLE_S0), k = u * u * (3 - 2 * u)) CABLE_Z + (CHANNEL_H - CHANNEL_W / 2 - CABLE_Z) * k;
// the centreline in the plug's frame (+x = along the plug, +y = toward the east), with the distance travelled
function cable_pts() = let (arc = [for (i = [0 : 24]) let (a = CABLE_TURN * i / 24)
                                    [CABLE_ARC0 + CABLE_ARC_R * sin(a), CABLE_ARC_R * (1 - cos(a))]],
                            e = arc[24], dir = [cos(CABLE_TURN), sin(CABLE_TURN)])
  concat([for (s = [CHANNEL_START : 2 : CABLE_ARC0 - 1]) [s, 0]], arc, [for (k = [3 : 3 : 90]) e + dir * k]);
module channel() {
  pts = cable_pts();
  along_usb() for (i = [0 : len(pts) - 2]) let (a = pts[i], b = pts[i + 1], za = cable_z(a[0]), zb = cable_z(b[0]))
    hull() {
      translate([a[0], a[1], za]) sphere(d = CHANNEL_W, $fn = 16);
      translate([b[0], b[1], zb]) sphere(d = CHANNEL_W, $fn = 16);
      translate([a[0], a[1], -0.01]) cylinder(d = CHANNEL_W, h = 0.01, $fn = 16);
      translate([b[0], b[1], -0.01]) cylinder(d = CHANNEL_W, h = 0.01, $fn = 16);
    }
}
// THE COPPER SLEEVE (user: "if we can make the copper sleeve look really good"): purely the look -- a pipe leaves the south
// junction box and bends down into the board, a collar at the box and a flange with two rivets at the board. It stands
// above the board top, so the 6.0 mm filament swap makes it copper with the wires.
SLEEVE_R  = 2.3;     // pipe radius
SLEEVE_BEND = 4.6;   // bend radius
module copper_sleeve() {
  s0 = TONGUE_R + FIT + 0.15;   // just off the box's face
  along_usb() {
    translate([s0, 0, BASE_H + 2 - SLEEVE_BEND]) rotate([90, 0, 0]) rotate_extrude(angle = 90, $fn = 48)
      translate([SLEEVE_BEND, 0]) circle(r = SLEEVE_R, $fn = 24);
    translate([s0, 0, BASE_H + 2]) rotate([0, 90, 0]) cylinder(r = SLEEVE_R + 0.5, h = 1.2, $fn = 24);                // collar
    translate([s0 + SLEEVE_BEND, 0, BASE_H - 0.01]) cylinder(r = SLEEVE_R + 0.9, h = 0.6, $fn = 32);                  // flange
    for (y = [-1, 1]) translate([s0 + SLEEVE_BEND, y * (SLEEVE_R + 0.45), BASE_H + 0.55]) sphere(r = 0.35, $fn = 10);  // rivets
  }
}

function plate_screws() = [for (k = [0 : 2]) pol(PLATE_SCREW_R, USB_DIR + 180 + k * 120)];

// a ring sector in the xz plane turned round z: r0..r1, z0..z1, centered on angle a, w mm of arc at r1
module sector(r0, r1, z0, z1, a, w) {
  ang = w / r1 * 180 / PI;
  rotate([0, 0, a - ang / 2]) rotate_extrude(angle = ang, $fn = 120)
    translate([r0, z0]) square([r1 - r0, z1 - z0]);
}

// finger + hook, as an (r, z) profile turned through the finger's width
module finger(a) {
  r_in = COL_R - HOOK_T;
  tip = HOLE_R + HOOK_OVER;
  catch_z = BASE_H - FIT * tan(HOOK_CATCH) + HOOK_LIFT;     // the catch meets the hole's edge HOOK_LIFT above the board top
  tip_z0  = catch_z + (tip - COL_R) * tan(HOOK_CATCH);
  tip_z1  = tip_z0 + 0.3;
  top_z   = tip_z1 + (tip - COL_R) * tan(HOOK_LEAD);
  ang = HOOK_W / COL_R * 180 / PI;
  rotate([0, 0, a - ang / 2]) rotate_extrude(angle = ang, $fn = 120)
    polygon([[r_in, HOOK_ROOT], [COL_R, HOOK_ROOT], [COL_R, catch_z], [tip, tip_z0], [tip, tip_z1], [COL_R, top_z], [r_in, top_z]]);
}
function finger_top() = BASE_H - FIT * tan(HOOK_CATCH) + HOOK_LIFT + (HOLE_R + HOOK_OVER - COL_R) * (tan(HOOK_CATCH) + tan(HOOK_LEAD)) + 0.3;

module rounded_box(l, w, h, r) { linear_extrude(h) translate([r, r]) offset(r = r, $fn = 24) square([l - 2 * r, w - 2 * r]); }

// an arm, from the rim over the collar, its top edges (sides + outer end) rounded
module arm() {
  e = EDGE_R; x0 = RIM_R - 3;
  hull() {
    translate([x0, -ARM_W / 2, 0]) cube([ARM_R1 - x0, ARM_W, REACTOR_H - e]);
    for (s = [-1, 1]) {
      translate([x0, s * (ARM_W / 2 - e), REACTOR_H - e]) rotate([0, 90, 0]) cylinder(r = e, h = ARM_R1 - e - x0, $fn = 20);
      translate([ARM_R1 - e, s * (ARM_W / 2 - e), REACTOR_H - e]) sphere(r = e, $fn = 20);
    }
  }
}
// a junction box: the rounded outline, its top edge rounded too
module filleted_box() {
  e = EDGE_R;
  hull() {
    linear_extrude(BOX_H - e) box2d();
    translate([0, 0, BOX_H - e]) minkowski() { linear_extrude(0.001) offset(delta = -e) box2d(); sphere(r = e, $fn = 16); }
  }
}
// The parts above the board: the rim round the glass, the collar, three arms and their junction boxes.
module reactor() {
  rotate_extrude($fn = 120) difference() {
    square([RIM_R, TOP]);
    translate([RIM_R - EDGE_R, TOP - EDGE_R]) difference() { square([EDGE_R + 0.01, EDGE_R + 0.01]); circle(r = EDGE_R, $fn = 24); }
  }
  translate([0, 0, BASE_H]) rotate_extrude($fn = 160)
    polygon([[0, 0], [REACTOR_R, 0], [REACTOR_R, COLLAR_H - 1], [REACTOR_R - 1, COLLAR_H], [0, COLLAR_H]]);
  for (a = ARM_ANGLES) rotate([0, 0, a]) {
    translate([0, 0, BASE_H]) arm();
    translate([0, 0, BASE_H]) filleted_box();
  }
}
// its surface detail: fins on the collar, ribs across the arms, a panel + port on each box
module reactor_detail() {
  for (a = ARM_ANGLES) for (f = [24 : FIN_STEP : 96]) rotate([0, 0, a + f])
    translate([FIN_R[0], -FIN_W / 2, BASE_H + COLLAR_H - FIN_DEPTH]) cube([FIN_R[1] - FIN_R[0], FIN_W, FIN_DEPTH + 1]);
  for (a = ARM_ANGLES) rotate([0, 0, a]) {
    for (r = RIB_R) translate([r - RIB_W / 2, -ARM_W / 2 - 0.1, BASE_H + REACTOR_H - RIB_D]) cube([RIB_W, ARM_W + 0.2, RIB_D + 0.1]);
    translate([BOX_R0 + 1.6, -BOX_W / 2 + 1.6, BASE_H + BOX_H - 0.4]) linear_extrude(0.5) difference() {
      offset(r = 1, $fn = 16) translate([1, 1]) square([BOX_R1 - BOX_R0 - 5.2, BOX_W - 5.2]);
      offset(r = 0.4, $fn = 16) translate([1.6, 1.6]) square([BOX_R1 - BOX_R0 - 6.4, BOX_W - 6.4]);
    }
    translate([(BOX_R0 + BOX_R1) / 2, 0, BASE_H + BOX_H - 0.8]) cylinder(r = 1.6, h = 1, $fn = 24);   // the port
  }
}
module flip_fingers() { translate([0, 0, BASE_H + FLANGE_T]) mirror([0, 0, 1]) children(); }   // catch the pocket ceiling
COL_Z0 = BASE_H + FLANGE_T - finger_top();   // the column reaches down to the hooks

module hub() {
  difference() {
    union() {
      translate([0, 0, COL_Z0]) cylinder(r = COL_R, h = BASE_H - COL_Z0 + 0.01, $fn = 160);   // column (in the hole)
      linear_extrude(BASE_H) tongue2d();                                                      // tongue (in its slot)
      reactor();
    }
    reactor_detail();
    translate([0, 0, -0.01]) cylinder(d = BORE_D, h = TOP - LIP_T + 0.01, $fn = 120);       // module cavity
    translate([0, 0, -0.01]) cylinder(d = GLASS_D - 2 * LIP_W, h = TOP + 0.02, $fn = 120);  // window
    translate([0, 0, -0.01]) cylinder(d = PLATE_D + 0.6, h = PLATE_T + 0.01, $fn = 120);    // plate pocket
    along_usb() translate([BORE_D / 2 - 2, -USB_TUNNEL[0] / 2, -0.01])                       // plug tunnel, open underneath
      cube([USB_TUNNEL[2] - BORE_D / 2 + 2, USB_TUNNEL[0], USB_TUNNEL[1]]);
    for (s = plate_screws()) translate([s[0], s[1], PLATE_T - 0.01]) cylinder(d = PLATE_SCREW_D, h = 8, $fn = 16);
    channel();
    // free the fingers: a slot behind, slits at the sides (mirrored: the root is at the top now)
    flip_fingers() for (a = HOOK_ANGLES) sector(COL_R - HOOK_T - HOOK_GAP, HOLE_R + 1.5, HOOK_ROOT, finger_top() + 0.4, a, HOOK_W + 2 * HOOK_GAP);
  }
  flip_fingers() for (a = HOOK_ANGLES) finger(a);
}

module plate() {
  post_h = PLATE_POST_H;
  difference() {
    union() {
      translate([0, 0, -PLATE_T]) cylinder(d = PLATE_D, h = PLATE_T, $fn = 96);
      for (h = SCREEN_HOLES) translate([h[0], h[1], -0.01]) cylinder(d = 4.2, h = post_h, $fn = 24);
    }
    for (s = plate_screws()) translate([s[0], s[1], -PLATE_T - 0.01]) cylinder(d = PLATE_PASS_D, h = PLATE_T + 0.02, $fn = 16);
    translate([-USB_NOTCH[0] / 2, -(BORE_D / 2 + USB_NOTCH[1]), -PLATE_T - 0.01]) cube([USB_NOTCH[0], USB_NOTCH[1] + 6, PLATE_T + 0.02]);
  }
}

// ---- the halves (center test) --------------------------------------------------
module tab2d(x, side, grow = 0) {   // side +1: north half's tab, pointing south
  d = -side;
  offset(delta = grow) polygon([[x - NECK / 2, -d * 0.5], [x - HEAD / 2, d * DEPTH], [x + HEAD / 2, d * DEPTH], [x + NECK / 2, -d * 0.5]]);
}
// a ball on each flank of the tab, halfway along it
module tab_bumps(x, side, r) {
  d = -side;
  for (sx = [-1, 1]) {
    mid = [x + sx * (NECK + HEAD) / 4, d * DEPTH / 2];   // halfway along the flank
    n = [sx * DEPTH, -d * (HEAD - NECK) / 2];             // the flank's outward normal
    c = mid - n / norm(n) * (BUMP_R - BUMP_OUT);          // ball inside the tab, BUMP_OUT proud of the flank
    translate([c[0], c[1], BUMP_Z]) sphere(r = r, $fn = 24);
  }
}

// 2026-11-11 (user): the south TEST piece gets a strip on its southern tip so it takes in the copper sleeve and the
// start of the cable's S-curve (both begin just past r 70)
TEST_TIP = [24, 86];   // width, reach from the center
module test_region(side) { half_region(side, TEST_R); if (side < 0) translate([-TEST_TIP[0] / 2, -TEST_TIP[1]]) offset(r = 3, $fn = 24) offset(delta = -3) square([TEST_TIP[0], TEST_TIP[1] - 30]); }
module half_region(side, r) {   // side +1 north, -1 south
  intersection() {
    circle(r = r, $fn = 360);
    translate([-r - 1, side > 0 ? 0 : -r - 1]) square([2 * r + 2, r + 1]);
  }
}

// a wedge between two MOCKUP angles
module wedge2d(a0, a1) { polygon(concat([[0, 0]], [for (a = [a0 : (a1 - a0) / 12 : a1]) mpol(260, a)])); }
// THE COPPER LINES: two engraved lines round the Core, broken at the Core worlds / lanes, with brackets across
module copper_cut() {
  engrave(COPPER_D) difference() {
    union() for (r = COPPER_R) ring2d(r, COPPER_W);
    for (g = CH_COPPER_GAPS) wedge2d(g[0], g[1]);
    for (b = CH_BRACKETS) let (h = BRACKET_W / 2 / ((COPPER_R[0] + COPPER_R[1]) / 2) * 180 / PI) wedge2d(b - h, b + h);
  }
  for (b = CH_BRACKETS) let (h = BRACKET_W / 2 / ((COPPER_R[0] + COPPER_R[1]) / 2) * 180 / PI) {
    for (s = [-1, 1]) engrave(0.6) groove2d(mpol(BRACKET_R[0], b + s * h), mpol(BRACKET_R[1], b + s * h), 0.8);   // the bracket's edges
    engrave(0.6) translate(mpol((COPPER_R[0] + COPPER_R[1]) / 2, b)) circle(r = 0.8, $fn = 16);                   // its rivet
  }
}
// RAISED COPPER (user 2026-11-11: "raised ... like copper wires with the clamp over it"): two round wires
// standing ~1 mm proud, broken only at the Core names + under the junction boxes, and a clamp with a rivet
// across both every 60 deg. Nothing else on the board stands above its top: SWAP TO COPPER FILAMENT AT 6.0 mm.
WIRE_R  = 0.7;    // wire radius (1.4 mm thick)
WIRE_Z  = 0.25;   // its center above the board top -> stands 0.95 mm proud
CLAMP_H = 1.6;    // clamp height above the board top
CLAMP_W = 2.8;    // clamp width along the ring (mm)
module copper_raised() {
  difference() {
    for (r = COPPER_R) rotate_extrude($fn = 360) translate([r, BASE_H + WIRE_Z]) circle(r = WIRE_R, $fn = 20);
    for (g = CH_COPPER_GAPS) translate([0, 0, BASE_H - 2]) linear_extrude(6) wedge2d(g[0], g[1]);
  }
  for (g = CH_COPPER_GAPS) for (e = g) for (r = COPPER_R) let (q = mpol(r, e))   // rounded wire ends
    translate([q[0], q[1], BASE_H + WIRE_Z]) sphere(r = WIRE_R, $fn = 20);
  for (b = CH_BRACKETS) rotate([0, 0, -b]) {
    hull() {
      translate([BRACKET_R[0], -CLAMP_W / 2, BASE_H - 0.01]) cube([BRACKET_R[1] - BRACKET_R[0], CLAMP_W, CLAMP_H - 0.5]);
      translate([BRACKET_R[0] + 0.5, -CLAMP_W / 2 + 0.5, BASE_H]) cube([BRACKET_R[1] - BRACKET_R[0] - 1, CLAMP_W - 1, CLAMP_H]);
    }
    translate([(COPPER_R[0] + COPPER_R[1]) / 2, 0, BASE_H + CLAMP_H]) scale([1, 1, 0.6]) sphere(r = 0.8, $fn = 20);   // the rivet
  }
}
module groove2d(a, b, w) { hull() { translate(a) circle(d = w, $fn = 16); translate(b) circle(d = w, $fn = 16); } }
module engrave(depth) { translate([0, 0, BASE_H - depth]) linear_extrude(depth + 0.01) children(); }
module ring2d(r, w) { difference() { circle(r = r + w / 2, $fn = 360); circle(r = r - w / 2, $fn = 360); } }

// A world: token recess + peg hole + 3 fleet holes. Core worlds turn their
// fleet holes AWAY from the bezel; the rest use the mockup's (one north, two below).
// the gap between a world's fleet holes (90 / 210 / 330) that points most nearly outward (angle `out`)
function angd(a, b) = abs((((a - b) % 360) + 540) % 360 - 180);
function letter_gap(out) = let (g = [30, 150, 270], d = [for (x = g) angd(x, out)]) g[search(min(d), d)[0]];
module world_cut(i) {
  p = world_at(i);
  core = WORLDS[i][1] == CORE_R;
  translate([p[0], p[1], BASE_H - SLOT_DEPTH]) cylinder(d = SLOT_D, h = SLOT_DEPTH + 0.01, $fn = 64);
  translate([p[0], p[1], BASE_H - SLOT_DEPTH - PEG_HOLE_DEPTH]) cylinder(d = PEG_HOLE_D, h = PEG_HOLE_DEPTH + 0.01, $fn = 24);
  for (k = [-1 : 1]) let (h = p + pol(FLEET_HOLE_R, -WORLDS[i][2] + k * 120))   // every world: one toward the edge, two angled back
    translate([h[0], h[1], BASE_H - FLEET_HOLE_DEPTH]) cylinder(d = FLEET_HOLE_D, h = FLEET_HOLE_DEPTH + 0.01, $fn = 16);
  if (WORLDS[i][3] >= 0) {   // a home world: an engraved ring + its faction's letter
    engrave(LABEL_DEPTH) translate(p) difference() { circle(r = HOME_RING[1], $fn = 64); circle(r = HOME_RING[0], $fn = 64); }
  }
}

// ---- THE CHARM (2026-11-11; mockups/charm3.html) ---------------------------------
TEXT_BOLD = 0.18;   // 2026-11-12: thicker strokes (engraved text read too thin on a 0.4 nozzle)
module charm_text() { for (g = CH_GLYPHS) translate([g[1], g[2]]) rotate(g[3]) offset(r = TEXT_BOLD, $fn = 8) text(g[0], size = g[4], font = "Liberation Sans:style=Bold", halign = "center", valign = "baseline"); }
// the game's faction symbols (web_server.cpp insigniaSvg, a 28-unit box, y down)
module insignia2d(f) {
  sw = 2.4;
  mirror([0, 1]) translate([-14, -14]) {
    if (f == 0) { translate([14, 14]) circle(r = 5, $fn = 32);
      for (s = [[[14, 2], [14, 7]], [[14, 21], [14, 26]], [[2, 14], [7, 14]], [[21, 14], [26, 14]], [[5.5, 5.5], [9, 9]], [[19, 19], [22.5, 22.5]], [[5.5, 22.5], [9, 19]], [[19, 9], [22.5, 5.5]]])
        hull() { translate(s[0]) circle(d = sw, $fn = 12); translate(s[1]) circle(d = sw, $fn = 12); } }
    if (f == 1) { difference() { offset(delta = sw / 2) polygon([[14, 2], [24.4, 8], [24.4, 20], [14, 26], [3.6, 20], [3.6, 8]]);
                                 offset(delta = -sw / 2) polygon([[14, 2], [24.4, 8], [24.4, 20], [14, 26], [3.6, 20], [3.6, 8]]); }
                  translate([14, 14]) circle(r = 4.5, $fn = 32); }
    if (f == 2) { difference() { offset(delta = sw / 2) polygon([[14, 2], [26, 14], [14, 26], [2, 14]]);
                                 offset(delta = -sw / 2) polygon([[14, 2], [26, 14], [14, 26], [2, 14]]); }
                  translate([14, 14]) circle(r = 4, $fn = 32); }
    if (f == 3) difference() { translate([14.417, 14]) circle(r = 11, $fn = 64); translate([19, 14]) circle(r = 10, $fn = 64); }
  }
}
module polyline2d(pts, w) { for (j = [0 : len(pts) - 2]) hull() { translate(pts[j]) circle(d = w, $fn = 10); translate(pts[j + 1]) circle(d = w, $fn = 10); } }
module station_cut(a) {
  c = mpol(MID_R, a);
  for (g = [90, 210, 330]) let (h = c + mpol(FLEET_HOLE_R, g))   // fleet holes off the seam
    translate([h[0], h[1], BASE_H - FLEET_HOLE_DEPTH]) cylinder(d = FLEET_HOLE_D, h = FLEET_HOLE_DEPTH + 0.01, $fn = 16);
  engrave(LABEL_DEPTH) translate(c) {
    difference() { circle(r = 10.05, $fn = 64); circle(r = 9.15, $fn = 64); }   // docking ring
    difference() { circle(r = 6.0, $fn = 48); circle(r = 5.2, $fn = 48); }     // core
    for (g = [30, 150, 270]) hull() { translate(mpol(5.6, g)) circle(d = 0.9, $fn = 10); translate(mpol(9.6, g)) circle(d = 0.9, $fn = 10); }   // arms
    circle(r = 1.5, $fn = 24);
  }
}
module charm_cut() {
  engrave(LABEL_DEPTH) charm_text();
  engrave(LABEL_DEPTH) for (s = CH_INSIGNIA) translate([s[1], s[2]]) rotate(s[3]) scale(2 * s[4] / 28) insignia2d(s[0]);
  engrave(LABEL_DEPTH) for (s = CH_STARS) translate([s[0], s[1]]) circle(r = max(s[2], 0.5), $fn = 12);
  engrave(LABEL_DEPTH) { ring2d(146.9, 0.6); for (k = CH_TICKS) groove2d([k[0], k[1]], [k[2], k[3]], 0.6); }   // the chart border
  engrave(0.6) for (n = CH_NEB) polyline2d(n[1], n[0]);                                                // orbit nebulae
  for (a = STATIONS) station_cut(a);
}

function hangar_holes(a) = [for (k = [-1 : 1]) mpol(HANG_R, a + k * HANG_STEP)];
module hangar_cut(h) {
  a = h[1];
  for (q = hangar_holes(a)) translate([q[0], q[1], BASE_H - FLEET_HOLE_DEPTH]) cylinder(d = FLEET_HOLE_D, h = FLEET_HOLE_DEPTH + 0.01, $fn = 16);
  engrave(0.8) intersection() {   // the bracket arc just outside its holes
    ring2d(HANG_R + 7, 1.2);
    polygon([[0, 0], mpol(250, a - 2.2 * HANG_STEP), mpol(250, a + 2.2 * HANG_STEP)]);
  }
  hc = mpol(HANG_R, a);
  engrave(LANE_DEPTH) groove2d(hc, world_at(h[2]), LANE_W * 0.8);   // its lane to the home world
  // FLEET NUMBERS 1 / 2 / 3 (2026-11-11), between the holes and the bracket, left to right from that player's edge
  for (k = [-1 : 1]) let (th = -(a + k * HANG_STEP))
    engrave(LABEL_DEPTH) translate(pol(HANG_R + NUM_R, th)) rotate(th + 90)
      text(str(2 - k), size = NUM_SIZE, font = "Liberation Sans:style=Bold", halign = "center", valign = "center");
  // the emergency lane (opens when the home world falls): dashes from the hangar's nearest hole to the
  // nebula's nearest fleet hole (2026-11-11: the old lane ran into the nebula's dimples)
  e = esc_lane(h);
  v = e[1] - e[0];
  L = norm(v);
  for (t = [ESC_END : ESC_DASH + ESC_GAP : L - ESC_END - 0.5]) engrave(RING_DEPTH) groove2d(e[0] + v / L * t, e[0] + v / L * min(t + ESC_DASH, L - ESC_END), RING_W);
}
ESC_END  = 3.4;   // the dashes stop this far from each hole's center
ESC_DASH = 2.2;
ESC_GAP  = 1.8;
ESC_CLEAR = 2.2;  // nebula dimples keep this far from the lane
function nearest(pts, to) = let (d = [for (q = pts) norm(q - to)]) pts[search(min(d), d)[0]];
function hangar_nebula(h) = NEBULAE[h[1] < 90 || h[1] > 270 ? 0 : 1];
// [hangar hole, nebula hole]: the closest pair
function esc_lane(h) = let (nh = nebula_holes(hangar_nebula(h)), hh = hangar_holes(h[1]),
                            pairs = [for (a = hh) for (b = nh) [a, b]], d = [for (pq = pairs) norm(pq[1] - pq[0])])
                       pairs[search(min(d), d)[0]];
function seg_dist(q, a, b) = let (v = b - a, s = max(0, min(1, (q - a) * v / (v * v)))) norm(q - (a + v * s));

function nebula_holes(n) = [for (k = [-1 : 1]) [mpol(OUT_R, n[0])[0] + k * 10, -n[1]]];
module nebula_cut(n, seed) {
  c = mpol(OUT_R, n[0]);
  holes = nebula_holes(n);
  for (q = holes) translate([q[0], q[1], BASE_H - FLEET_HOLE_DEPTH]) cylinder(d = FLEET_HOLE_D, h = FLEET_HOLE_DEPTH + 0.01, $fn = 16);
  if (false) let (pts = rands(0, 1, NEBULA_DIMPLES * 2, seed))
  // engraved dimples you can feel, clear of the holes and the seam
  for (i = [0 : NEBULA_DIMPLES - 1]) let (a = pts[2 * i] * 360, rr = sqrt(pts[2 * i + 1]),
                                          q = [c[0] + rr * NEBULA_RX * cos(a), c[1] + rr * NEBULA_RY * sin(a)])
    if (abs(q[1]) > 1.2 && len([for (h = holes) if (norm(q - h) < 7.5 / 2 + 1) 1]) == 0
        && len([for (hg = HANGARS) let (e = esc_lane(hg)) if (seg_dist(q, e[0], e[1]) < ESC_CLEAR) 1]) == 0)
      translate([q[0], q[1], BASE_H - 0.5]) cylinder(d = 1.0 + (i % 3) * 0.3, h = 0.51, $fn = 10);
}

// One half of the board. full = false: the center test print (to TEST_R).
module half(side, full = true, joints = true) {   // joints = false: no dovetails (the single-piece board)
  r = full ? BOARD_R : TEST_R;
  tabs = !joints ? [] : full ? TABS : TEST_TABS;
  difference() {
    union() {
      linear_extrude(BASE_H) difference() {
        union() {
          if (full) half_region(side, r); else test_region(side);
          for (t = tabs) if (t[1] == side) tab2d(t[0], t[1]);
        }
        for (t = tabs) if (t[1] != side) tab2d(t[0], t[1], JOINT_CLEAR);   // sockets for the other half's tabs
      }
      for (t = tabs) if (t[1] == side) tab_bumps(t[0], t[1], BUMP_R);
      if (full) intersection() { linear_extrude(BASE_H + 5) half_region(side, r); copper_raised(); }   // 2026-11-11: RAISED copper
      if (side < 0) intersection() { linear_extrude(BASE_H + 5) if (full) half_region(side, r); else test_region(side); copper_sleeve(); }  // the cable's copper sleeve
    }
    for (t = tabs) if (t[1] != side) tab_bumps(t[0], t[1], BUMP_R + JOINT_CLEAR);   // dimples
    // hub hole (+ the tongue's slot) and the flange pocket
    translate([0, 0, -0.01]) linear_extrude(BASE_H + 0.02) { circle(r = HOLE_R, $fn = 160); tongue2d(FIT); }
    translate([0, 0, -0.01]) cylinder(r = FLANGE_R + FIT, h = FLANGE_T + 0.01, $fn = 160);
    channel();
    // ring routes, lanes, worlds
    for (rr = full ? [CORE_R, MID_R, OUT_R] : [CORE_R]) engrave(RING_DEPTH) ring2d(rr, RING_W);
    if (full) {
      for (l = LANES) if (l != [12, 16]) engrave(LANE_DEPTH) groove2d(world_at(l[0]), world_at(l[1]), LANE_W);
      engrave(LANE_DEPTH) { groove2d(world_at(12), mpol(CH_LANE_BREAK[0], 270), LANE_W); groove2d(mpol(CH_LANE_BREAK[1], 270), world_at(16), LANE_W); }   // broken behind CORUSCANT
      for (i = [0 : len(WORLDS) - 1]) world_cut(i);
      charm_cut();   // 2026-11-11: hangars removed (start on your home world; no worlds -> a space station)
      for (k = [0 : len(NEBULAE) - 1]) nebula_cut(NEBULAE[k], 11 + k);
      // the top edge, chamfered
      translate([0, 0, BASE_H - EDGE_CHAMFER]) difference() {
        cylinder(r = r + 1, h = EDGE_CHAMFER + 0.01, $fn = 360);
        cylinder(r1 = r, r2 = r - EDGE_CHAMFER, h = EDGE_CHAMFER + 0.01, $fn = 360);
      }
    } else {
      for (i = [14 : 16]) world_cut(i);   // the Core
      for (l = [[12, 16], [9, 14], [9, 15]]) engrave(LANE_DEPTH) groove2d(world_at(l[0]), world_at(l[1]), LANE_W);
    }
  }
}

module print_flip() { translate([0, 0, BASE_H]) rotate([180, 0, 0]) children(); }

// ---- parts --------------------------------------------------------------------
if (PART == "hub") hub();
else if (PART == "plate") translate([0, 0, PLATE_T]) plate();   // flat, posts up
else if (PART == "half_n") half(1);   // 2026-11-11: exported TOP UP (the user prints them that way)
else if (PART == "half_s") half(-1);
else if (PART == "single") union() { half(1, true, false); half(-1, true, false); }   // ONE piece, 296 mm: needs a 300+ mm bed
else if (PART == "test_n") half(1, false);
else if (PART == "test_s") half(-1, false);
// 2026-11-12: the TEXT TEST -- a corner of the south half with real names, stars, the border, copper + the sleeve, to try
// the dark-under-light colour swap before a full half (the centre test pieces carry no names)
else if (PART == "test_text") intersection() { half(-1); translate([-24, -150, -1]) cube([108, 92, 20]); }
else if (PART == "engr") intersection() {   // CHECK VIEW: only the top 0.45 mm -> every engraving shows as a see-through hole
  union() { half(1); half(-1); }
  translate([-160, -160, BASE_H - 0.45]) cube([320, 320, 1]);
}
else if (PART == "top") {   // the flat layout check: both halves and the hub from above
  color("#3A4A5E") half(1);
  color("#2E3B4C") half(-1);
  color("#FFD166") hub();
} else if (PART == "exploded") {
  color("#3A4A5E") translate([0, 18, 0]) half(1);
  color("#2E3B4C") translate([0, -18, 0]) half(-1);
  color("#FFD166") translate([0, 0, -30]) hub();
  color("#8A9AAA") translate([0, 0, -48]) plate();
} else if (PART == "section") {   // cut through the north hook and the tongue (x = 0), looking from the east
  intersection() {
    union() {
      color("#3A4A5E") half(1);
      color("#2E3B4C") half(-1);
      color("#FFD166") hub();
      color("#8A9AAA") translate([0, 0, PLATE_T]) plate();
    }
    translate([-200, -200, -50]) cube([200, 400, 100]);
  }
} else {
  color("#3A4A5E") half(1);
  color("#2E3B4C") half(-1);
  color("#FFD166") hub();
  color("#8A9AAA") translate([0, 0, PLATE_T]) plate();
}
